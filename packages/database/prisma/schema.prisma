// Milestone 1 schema: foundation entities only.
// Full entity set (MovieWatch, BookingPreference, BookingAttempt, Booking,
// AgentEvent, AuditLog, …) lands with Milestones 3–9 per PLAN.md §13.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform user. Authentication is owned by Clerk; we store no passwords.
model User {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  email        String   @unique
  displayName  String?
  notifyPush   Boolean  @default(true)
  notifyEmail  Boolean  @default(true)
  notifySms    Boolean  @default(false)
  /// Stripe customer for off-session auto-booking charges (Milestone 5).
  stripeCustomerId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  watches      MovieWatch[]
  paymentMethods PaymentMethod[]

  @@index([clerkUserId])
}

/// Saved card for auto-booking (Milestone 5). Raw PAN never touches our DB —
/// only Stripe's payment-method reference plus display metadata.
model PaymentMethod {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentMethodId String  @unique
  brand               String
  last4               String
  expMonth            Int
  expYear             Int
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

/// Movie metadata cached from TMDB (see Milestone 2).
/// TMDB free tier is non-commercial only — a commercial agreement is a
/// launch blocker (PLAN.md §6 Tier 0). Cache TTL ≤ 6 months per TMDB terms.
model Movie {
  id               String   @id @default(cuid())
  tmdbId           Int      @unique
  title            String
  releaseDate      DateTime?
  posterPath       String?
  backdropPath     String?
  overview         String?
  runtime          Int?
  genres           String[] @default([])
  trailerKey       String?
  popularity       Float?
  voteAverage      Float?
  /// Full TMDB details payload from the last fetch (cast, trailer, …),
  /// JSON-encoded. Served on cache hits so we don't refetch per view.
  detailsJson      String?
  tmdbCacheExpiresAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([releaseDate])
  @@index([popularity])
}

/// Theater directory entry (populated in Milestone 5 from provider rails).
model Theater {
  id               String  @id @default(cuid())
  provider         String
  providerTheaterId String
  name             String
  address          String?
  city             String?
  zip              String?
  latitude         Float?
  longitude        Float?
  timezone         String  @default("America/Chicago")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerTheaterId])
  @@index([zip])
}

/// A user's watch on a future movie (Milestone 3).
/// Status follows the booking state machine (contracts: WatchStatus).
model MovieWatch {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId          Int
  movieTitle      String   // denormalized for list views
  status          String   @default("CREATED")
  zip             String
  armedAt         DateTime?
  expiresAt       DateTime?
  cadenceMinutes  Int      @default(1440) // base poll cadence; adaptive in M4
  policyDocument  String?  // signed JSON policy (policy-engine)
  policyVersion   Int      @default(0)
  policySignature String?  // HMAC-SHA256 of policyDocument
  consentRecord   String?  // JSON: accepted limits summary + timestamp
  // Action mode (Milestone 5+): what the agent does when tickets are found.
  // "notify" (default): email alert with booking link. "autobook": charge the
  // saved card when matching tickets are found, never exceeding maxTotalCents.
  // consentAt records the moment the user explicitly authorized automatic purchase.
  actionMode      String    @default("notify")
  autoBookEnabled Boolean   @default(false)
  consentAt       DateTime?
  maxTotalCents   Int?
  // Monitoring schedule (user-configurable): how often the agent checks this
  // watch. One of every_15_min | hourly | every_6_hours | daily.
  // lastCheckedAt is stamped by the scheduler after each pass.
  checkFrequency  String    @default("every_15_min")
  lastCheckedAt   DateTime?
  idempotencyKey  String   @unique @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  preferences     BookingPreference[]

  @@index([userId, status])
  @@index([tmdbId])
}

/// One ranked booking preference per watch (Milestone 4).
/// Each dimension has a first choice (rank 1) and an optional backup (rank 2).
/// The booking agent prefers showings matching more rank-1 dimensions.
model BookingPreference {
  id                   String   @id @default(cuid())
  watchId              String   @unique
  watch                MovieWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  // Theaters: first choice + backup (Theater IDs from the directory)
  theatersRank1        String[] @default([])
  theatersRank2        String[] @default([])
  // Days of week: first choice + backup (0=Sun..6=Sat; empty = any day)
  daysRank1            Int[]    @default([])
  daysRank2            Int[]    @default([])
  dateFrom             DateTime?
  dateTo               DateTime?
  // Showtime windows: first choice + backup
  timeWindowsRank1     String[] @default([])
  timeWindowsRank2     String[] @default([])
  // Formats: first choice + backup (IMAX, XD, Dolby, ...)
  formatsRank1         String[] @default([])
  formatsRank2         String[] @default([])
  ticketCount          Int      @default(2)
  maxTicketPriceCents  Int
  seatRules            String?  // JSON SeatPreference
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Tamper-evident audit trail (Milestone 3). Hash-chained per resource.
model AuditLog {
  id            String   @id @default(cuid())
  actorType     String   // "user" | "system" | "workflow"
  actorId       String
  action        String
  resourceType  String
  resourceId    String
  policyVersion Int?
  prevHash      String?
  hash          String
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
}
