# Copy to .env and fill in. Never commit real secrets.
# Web (apps/web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_API_URL=http://localhost:4000

# API (apps/orchestrator-api)
PORT=4000
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moviewatch?schema=public
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# TMDB (apps/orchestrator-api, Milestone 2) — server-side only, never exposed to the web app.
# v4 read-access token preferred; v3 API key also works. Optional at boot:
# /movies endpoints return 503 until one is set.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Policy signing (Milestone 3) — generate with: openssl rand -hex 32
POLICY_SIGNING_SECRET=replace_me_with_32_plus_random_chars
