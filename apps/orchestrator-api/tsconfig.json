    "declaration": true,
    "declarationMap": true,
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2022",
    "noEmit": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": "@moviewatch/config/tsconfig.base.json",
